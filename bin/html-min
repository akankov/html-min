#!/usr/bin/env php
<?php

declare(strict_types=1);

// Locate the autoloader from any of the supported install layouts:
//   - cloning the repo (vendor/ next to bin/)
//   - composer-installed dependency (vendor/<vendor>/<package>/bin/, autoloader 3 levels up)
//   - PHAR (autoloader bundled at phar://html-min.phar/vendor/autoload.php)
$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$autoload = null;
foreach ($autoloadCandidates as $candidate) {
    if (is_file($candidate)) {
        $autoload = $candidate;
        break;
    }
}

if ($autoload === null) {
    fwrite(STDERR, "html-min: could not locate vendor/autoload.php\n");
    exit(1);
}

require $autoload;

$cli = new \Akankov\HtmlMin\Cli\Cli(
    new \Akankov\HtmlMin\HtmlMin(),
    STDIN,
    STDOUT,
    STDERR,
);

exit($cli->run($argv));

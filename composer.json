{
  "name": "akankov/html-min",
  "description": "HTML compressor and minifier for PHP 8.3+",
  "keywords": [
    "html",
    "compress",
    "compression",
    "minify",
    "minifier"
  ],
  "type": "library",
  "homepage": "https://github.com/akankov/html-min",
  "license": "MIT",
  "authors": [
    {
      "name": "Alex Kankov",
      "email": "akankov@gmail.com",
      "role": "Maintainer"
    }
  ],
  "require": {
    "php": "8.3.* || 8.4.* || 8.5.*",
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.65",
    "nyholm/psr7": "^1.8",
    "phan/phan": "^6.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0",
    "rector/rector": "^2.0"
  },
  "bin": [
    "bin/html-min"
  ],
  "autoload": {
    "psr-4": {
      "Akankov\\HtmlMin\\": "src/HtmlMin/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Akankov\\HtmlMin\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.3"
    },
    "sort-packages": true
  }
}
